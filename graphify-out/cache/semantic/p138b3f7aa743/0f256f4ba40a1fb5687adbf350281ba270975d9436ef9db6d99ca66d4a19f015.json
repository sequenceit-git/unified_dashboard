{"nodes": [{"id": "cursor_skills_tts_open_toolkit_references_cli_usage_tts_open_toolkit_cli_usage", "label": "TTS Open Toolkit CLI Usage Reference", "file_type": "document", "source_file": ".cursor/skills/tts-open-toolkit/references/cli-usage.md", "source_location": "L1-L243", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cursor_skills_tts_open_toolkit_references_cli_usage_cli_config_cache_precedence", "label": "CLI Configuration & Cache Precedence", "file_type": "concept", "source_file": ".cursor/skills/tts-open-toolkit/references/cli-usage.md", "source_location": "L58-L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves effective configuration via --config > TTS_OPEN_TOOLKIT_CONFIG > project .tts_open_toolkit/config.json > OS user config > defaults; stores update cache in OS cache or TTS_OPEN_TOOLKIT_STATE_PATH with an immutable UUID v4 anonymousInstallationId."}, {"id": "cursor_skills_tts_open_toolkit_references_cli_usage_ttspc_oauth_credential_store", "label": "TTSPC OAuth Profile & Protected Credential Store", "file_type": "concept", "source_file": ".cursor/skills/tts-open-toolkit/references/cli-usage.md", "source_location": "L108-L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses public client_id=open_toolkit_cli with scope open_toolkit:developer and shell:false browser launching (open, xdg-open, Base64 UTF-16LE PowerShell Start-Process), isolating non-secret profile metadata in ~/.tts_open_toolkit/config.json from tokens in macOS Keychain or Windows CurrentUser DPAPI."}, {"id": "cursor_skills_tts_open_toolkit_references_cli_usage_fixed_oauth_devapi_allowlist", "label": "Fixed OAuth DevAPI Allowlist (13 Methods)", "file_type": "concept", "source_file": ".cursor/skills/tts-open-toolkit/references/cli-usage.md", "source_location": "L130-L159", "source_url": null, "captured_at": null, "author": null, "contributor": nu