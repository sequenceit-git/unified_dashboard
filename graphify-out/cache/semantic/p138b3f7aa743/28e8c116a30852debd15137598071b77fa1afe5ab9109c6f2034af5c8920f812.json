{"nodes": [{"id": "design_erp_design_system", "label": "ERP Application Design System", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L1-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_modern_enterprise_direction", "label": "Modern Enterprise Design Direction (FIND -> UNDERSTAND -> ACT -> CONFIRM)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L3-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ERP is a high-density productivity tool handling serious business data (Linear x Stripe x modern accounting), not a flashy marketing site or Dribbble-style card showcase."}, {"id": "design_geist_typography", "label": "Geist Typography & Type Scale", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L29-L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricting to a single UI font (Geist) and establishing hierarchy via size and weight (400/500/600/700) preserves numeric legibility without visual clutter."}, {"id": "design_color_system", "label": "Indigo Primary & 80-90% Neutral Semantic Color System", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L70-L170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping 80-90% of the UI neutral and reserving Indigo (#4F46E5) for interactive actions and semantic colors (Green/Amber/Red/Blue/Grey) for statuses prevents visual fatigue."}, {"id": "design_layout_spacing_tokens", "label": "4px Spacing Scale, Restrained Radius & Elevation System", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L173-L243", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structured 6-12px radii, background+border cards instead of heavy shadows, and 120-200ms transitions keep the ERP feeling fast and disciplined rather than playful."}, {"id": "design_application_shell_navigation", "label": "Application Shell, Lucide Icons & Responsive Navigation", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L246-L315", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop-first persistent sidebar and business-vocabulary navigation degrade to collapsible tablet sidebars and prioritized mobile rows without hiding primary actions."}, {"id": "design_tables_forms_components", "label": "ERP Tables, Forms, Buttons, Cards, Modals & Drawers", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L318-L562", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches container complexity to task scope: modals for confirmations/quick edits, drawers for record previews, and full pages for complex multi-step workflows and large datasets."}, {"id": "design_workflow_first_ux", "label": "Workflow-First UX, Progressive Disclosure & Accessibility", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L565-L875", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designing around end-to-end Sales/Inventory/Accounts workflows with progressive disclosure, explicit destructive-action impact summaries, actionable empty/error states, and keyboard/non-color accessibility keeps frequent tasks fast and safe."}, {"id": "design_css_tokens_reference", "label": "CSS Design Tokens Reference", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L878-L926", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "design_modern_enterprise_direction", "target": "design_erp_design_system", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": "L3-L25", "weight": 1.0}, {"source": "desi