{"nodes": [{"id": "discovery_agent_architecture_product_discovery_agent", "label": "Product Discovery Agent Pipeline (discoveryAgent.js)", "file_type": "concept", "source_file": "discovery_agent_architecture.md", "source_location": "L1-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "discovery_agent_architecture_research_api_and_ai_settings", "label": "Research API Routes, Encrypted AI Settings & Catalog Export", "file_type": "concept", "source_file": "discovery_agent_architecture.md", "source_location": "L27-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores OpenAI key/model encrypted in app_settings (default gpt-5-mini with low reasoning fallback), guards single-run concurrency via 409, and defends CSV exports against formula injection."}, {"id": "discovery_agent_architecture_us_marketplace_scope", "label": "US 7+1 Marketplace Search Scope (No Supplier/Margin Research)", "file_type": "concept", "source_file": "discovery_agent_architecture.md", "source_location": "L35-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricts discovery to 7 US marketplaces (eBay, Amazon, Walmart, Temu, TikTok Shop, Etsy, Wish) plus US Shopify fallback capped at Tier 4 evidence, excluding non-US domains, Zendesk, and wholesale/margin research."}, {"id": "discovery_agent_architecture_evidence_memory", "label": "24-Hour Evidence Memory Cache (evidenceMemory.js)", "file_type": "concept", "source_file": "discovery_agent_architecture.md", "source_location": "L12-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses previously confirmed candidates from the last 24 hours by marketplace product ID, store URL, or title while preserving original observedAt."}, {"id": "discovery_agent_architecture_us_listing_verification", "label": "US Listing Link Verification (usListings.js)", "file_type": "concep