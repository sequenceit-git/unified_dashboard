{"nodes": [{"id": "agents_skills_ebay_shop_api_skill_ebay_shop_api", "label": "eBay Shop API Skill", "file_type": "document", "source_file": ".agents/skills/ebay-shop-api/SKILL.md", "source_location": "L1-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_ebay_shop_api_skill_ebay_us_scope", "label": "eBay US-Only Marketplace Scope", "file_type": "rationale", "source_file": ".agents/skills/ebay-shop-api/SKILL.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashboard connects only the organization's own US eBay shop (EBAY_US, USD, category tree 0); multi-site eBay shops are excluded."}, {"id": "agents_skills_ebay_shop_api_skill_ebay_official_mcp", "label": "Official eBay MCP Server (@ebay/npm-public-api-mcp)", "file_type": "concept", "source_file": ".agents/skills/ebay-shop-api/SKILL.md", "source_location": "L13-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred read-only OpenAPI discovery and execution surface registered as ebay-api in .cursor/mcp.json using query_ebay_api and call_ebay_api; unofficial eBay MCP servers are forbidden."}, {"id": "agents_skills_ebay_shop_api_skill_ebay_mcp_read_only_constraint", "label": "eBay MCP Production Read-Only Constraint", "file_type": "rationale", "source_file": ".agents/skills/ebay-shop-api/SKILL.md", "source_location": "L19-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official eBay MCP supports production only (no sandbox), rejects POST/PUT/DELETE, defaults to application token mode, and requires EBAY_TOKEN_TYPE=user plus EBAY_REFRESH_TOKEN for seller data; therefore mutations and shop sync must remain in backend/services/marketplace/ebay.js."}, {"id": "agents_skills_ebay_shop_api_skill_ebay_marketplace_service", "label": "eBay Marketplace Service (backend/services/marketplace/ebay.js)", "