{"nodes": [{"id": "agents_skills_tiktok_shop_api_skill_tiktok_shop_api", "label": "TikTok Shop API Skill", "file_type": "document", "source_file": ".agents/skills/tiktok-shop-api/SKILL.md", "source_location": "L1-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_tiktok_shop_api_skill_tiktok_us_custom_app_scope", "label": "TikTok US Seller-Developed Custom App Scope", "file_type": "rationale", "source_file": ".agents/skills/tiktok-shop-api/SKILL.md", "source_location": "L12-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets only the organization's own US TikTok Shop via partner.us.tiktokshop.com as a seller-developed custom app (not ISV, not UK/EU), and prohibits TikTok for Business MCP because business-api.tiktok.com is the Ads API rather than Shop."}, {"id": "agents_skills_tiktok_shop_api_skill_tiktok_hmac_signing", "label": "TikTok Shop HMAC-SHA256 Signing & shop_cipher", "file_type": "rationale", "source_file": ".agents/skills/tiktok-shop-api/SKILL.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signs requests with HMAC-SHA256 (app_secret key over app_secret + path + sorted query excluding sign/access_token + exact body + app_secret, lowercase hex), passes x-tts-access-token, and supplies shop_cipher from Get Authorized Shops."}, {"id": "agents_skills_tiktok_shop_api_skill_tiktok_marketplace_service", "label": "TikTok Shop Marketplace Service (backend/services/marketplace/tiktok.js)", "file_type": "concept", "source_file": ".agents/skills/tiktok-shop-api/SKILL.md", "source_location": "L31-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registered strictly as tiktok_shop (not tiktok) in marketplaceServices and backend/config/marketplaces.js, storing access/refresh tokens, expiry, and shop_cipher on Shop.auth without logging secrets