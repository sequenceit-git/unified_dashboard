{"nodes": [{"id": "cursor_skills_tiktok_shop_api_skill_tiktok_shop_api", "label": "TikTok Shop API Skill", "file_type": "document", "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L1-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cursor_skills_tiktok_shop_api_skill_tiktok_us_custom_app_policy", "label": "TikTok US Custom App Integration Policy", "file_type": "rationale", "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L12-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connects our own US TikTok Shop through US Partner Center (partner.us.tiktokshop.com) using a seller-developed custom app instead of an ISV app or UK/EU regions; prohibits TikTok for Business MCP because that is the Ads API (business-api.tiktok.com), not Shop API."}, {"id": "cursor_skills_tiktok_shop_api_skill_tiktok_hmac_sha256_signing", "label": "TikTok Shop HMAC-SHA256 Signing", "file_type": "concept", "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L25-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selects highest applicable six-digit API version from tts-openapi-guide and signs requests using HMAC-SHA256 with app_secret over app_secret + path + sorted query (excluding sign and access_token) + exact body + app_secret in lowercase hex, passing x-tts-access-token and shop_cipher from Get Authorized Shops."}, {"id": "cursor_skills_tiktok_shop_api_skill_tiktok_dashboard_connector", "label": "TikTok Shop Dashboard Connector Spec", "file_type": "concept", "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L31-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds backend/services/marketplace/tiktok.js registered as 'tiktok_shop' (not 'tiktok') matching eBay core methods and dispatching via shop.marketplace instead of hardcoding getService('ebay'); reads TIKTOK_SHOP_APP_KEY, TIKTOK_SHOP_APP_SECRET, TIKTOK_SHOP_SERVICE_ID from marketplaces.js and persists tokens, expiry, and shop_cipher on Shop.auth."}], "edges": [{"source": "cursor_skills_tiktok_shop_api_skill_tiktok_us_custom_app_policy", "target": "cursor_skills_tiktok_shop_api_skill_tiktok_shop_api", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L12-L14", "weight": 1.0}, {"source": "cursor_skills_tiktok_shop_api_skill_tiktok_shop_api", "target": "cursor_skills_tiktok_shop_api_skill_tiktok_hmac_sha256_signing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L25-L29", "weight": 1.0}, {"source": "cursor_skills_tiktok_shop_api_skill_tiktok_shop_api", "target": "cursor_skills_tiktok_shop_api_skill_tiktok_dashboard_connector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L31-L37", "weight": 1.0}, {"source": "cursor_skills_tiktok_shop_api_skill_tiktok_shop_api", "target": "cursor_skills_tts_developer_onboarding_guide_skill_tts_developer_onboarding_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L5, L18", "weight": 1.0}, {"source": "cursor_skills_tiktok_shop_api_skill_tiktok_shop_api", "target": "cursor_skills_tts_openapi_guide_skill_tts_openapi_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/tiktok-shop-api/SKILL.md", "source_location": "L5, L19, L27", "weight": 1.0}, {"source": "cursor_skills_tiktok_shop_api_skill_tiktok_shop_api", "target": "cursor_skills_tts_openapi_faq_index_skill_tts_openapi_faq_inde