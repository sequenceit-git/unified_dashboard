{"nodes": [{"id": "cursor_skills_temu_shop_api_skill_temu_shop_api", "label": "Temu Shop API Skill", "file_type": "document", "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L1-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cursor_skills_temu_shop_api_skill_temu_us_local_seller_policy", "label": "Temu US Local-Seller Path Policy", "file_type": "rationale", "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L11-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connects only our own US Temu shop via the US local-seller router (https://openapi-b-us.temu.com/openapi/router) and US Partner Platform docs; rejects EU/global routers, cross-border Seller Center, and third-party Temu MCP servers because Temu publishes no official MCP server."}, {"id": "cursor_skills_temu_shop_api_skill_temu_router_md5_signing", "label": "Temu Router & MD5 Request Signing", "file_type": "concept", "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L17-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every call is POST application/json with API name in 'type', app_key, 10-digit unix timestamp within 300 seconds, access_token, data_type=JSON, and sign_method=md5 uppercase hex over app_secret + sorted key+value concatenation + app_secret without logging secrets."}, {"id": "cursor_skills_temu_shop_api_skill_temu_local_oauth_flow", "label": "Temu Local-Seller OAuth & Token Exchange", "file_type": "concept", "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L25-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authorizes at seller.temu.com/open-platform/client-manage/authorization and exchanges code via bg.open.accesstoken.create (with code as initial access_token) to receive mall_id and access_token; uses documented US local methods such as bg.local.goods.detail.query rather than invented names."}, {"id": "cursor_skills_temu_shop_api_skill_temu_dashboard_connector", "label": "Temu Dashboard Connector & Order State Mapping", "file_type": "concept", "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L31-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implements TemuService in backend/services/marketplace/temu.js registered under 'temu' with TEMU_APP_KEY, TEMU_APP_SECRET, and region fixed to 'us', matching eBay core interface (getAuthUrl, exchangeCode, refreshToken, getOrders, getInventory, createListing, updateStock, updatePrice), storing token/mall_id on Shop.auth, and mapping Temu states into pending|paid|processing|shipped|delivered|cancelled|returned|refunded."}], "edges": [{"source": "cursor_skills_temu_shop_api_skill_temu_us_local_seller_policy", "target": "cursor_skills_temu_shop_api_skill_temu_shop_api", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L11-L13", "weight": 1.0}, {"source": "cursor_skills_temu_shop_api_skill_temu_shop_api", "target": "cursor_skills_temu_shop_api_skill_temu_router_md5_signing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L17-L21", "weight": 1.0}, {"source": "cursor_skills_temu_shop_api_skill_temu_shop_api", "target": "cursor_skills_temu_shop_api_skill_temu_local_oauth_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cursor/skills/temu-shop-api/SKILL.md", "source_location": "L25-L29", "weight": 1.0}, {"source": "cursor_skills_temu_shop_api_skill_temu_shop_api", "target": "cursor_skills_temu_shop_api_skill_temu_dashboard_connector", "relation": "references", "confidence": "EXTRACTED", "confidence