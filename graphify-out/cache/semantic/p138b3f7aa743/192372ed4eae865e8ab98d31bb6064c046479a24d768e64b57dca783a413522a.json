{"nodes": [{"id": "cursor_skills_ebay_shop_api_skill_ebay_shop_api", "label": "eBay Shop API Skill", "file_type": "document", "source_file": ".cursor/skills/ebay-shop-api/SKILL.md", "source_location": "L1-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cursor_skills_ebay_shop_api_skill_ebay_us_shop_policy", "label": "eBay US-Only Shop Policy", "file_type": "rationale", "source_file": ".cursor/skills/ebay-shop-api/SKILL.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connects only our own United States eBay shop using marketplace EBAY_US, currency USD, and category tree 0; other eBay sites must not be added."}, {"id": "cursor_skills_ebay_shop_api_skill_ebay_mcp_read_constraint", "label": "Official eBay MCP Read-Only Integration", "file_type": "rationale", "source_file": ".cursor/skills/ebay-shop-api/SKILL.md", "source_location": "L13-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses official ebay-api MCP (@ebay/npm-public-api-mcp) with query_ebay_api, call_ebay_api, and prompt interpret_user_request for production GET reads only (application mode by default, EBAY_TOKEN_TYPE=user + EBAY_REFRESH_TOKEN for seller inventory/orders/account); sandbox and POST/PUT/DELETE are rejected and unofficial eBay MCPs are forbidden."}, {"id": "cursor_skills_ebay_shop_api_skill_ebay_dashboard_write_sync", "label": "eBay Dashboard Write & OAuth Sync", "file_type": "concept", "source_file": ".cursor/skills/ebay-shop-api/SKILL.md", "source_location": "L27-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seller connect, listing publish, stock, price, fulfillment, and refunds remain in backend/services/marketplace/ebay.js because the official MCP cannot write; OAuth uses authBaseUrl/oauth2/authorize and apiBaseUrl/identity/v1/oauth2/token with HTTP Basic auth and scopes s