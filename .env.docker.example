# ==============================================================================
# Docker & Traefik Deployment Configuration
# Copy this to .env in your root directory when deploying on your server
# ==============================================================================

# Your public domain for the unified dashboard (e.g., dashboard.yourdomain.com)
DOMAIN=dashboard.yourdomain.com

# Name of your external Docker network where Traefik is running
# (common names: traefik-public, traefik_network, proxy, web)
TRAEFIK_NETWORK=traefik-public

# The entrypoint defined in your Traefik static configuration (default: websecure)
TRAEFIK_ENTRYPOINT=websecure

# The certificate resolver name in your Traefik configuration (e.g., letsencrypt, le, myresolver)
CERT_RESOLVER=letsencrypt

# Local Database connection string (default container service on internal-net)
MONGODB_URL=mongodb://mongo:27017/unified_dashboard
