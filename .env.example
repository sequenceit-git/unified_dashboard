# Copy to .env at the repo root (unified_dashboard/.env) and fill in secrets.
# Backend reads: PORT, MONGODB_URL (or MONGO_URI), CLIENT_URL, JWT_SECRET, JWT_EXPIRES_IN.
# Frontend reads (Vite, baked in at build time): VITE_API_URL, VITE_PORT.

PORT=5000
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/unified_dashboard?appName=<app>
# Comma-separated allowed frontend origins (local + deployed, no code changes needed).
CLIENT_URL=http://localhost:5173,https://unified-dashboard-lime.vercel.app
JWT_SECRET=<64-byte-hex-string>
JWT_EXPIRES_IN=7d

# Local dev: leave empty to use the Vite proxy (/api → http://localhost:5000).
# Deployed (Vercel): set to the backend URL, e.g. VITE_API_URL=https://unified-dashboard-zdfw.vercel.app
VITE_API_URL=
VITE_PORT=5173
