# Single env file for this repo. Copy to .env in the project root.
# The backend, the Vite frontend (VITE_*), and Docker Compose all read this file.
# Do not create backend/.env or frontend/.env.

# Docker / Traefik (used by docker-compose.yml)
DOMAIN=your.domain.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt

# Server and database
PORT=5000
# Docker on the server: mongodb://mongo:27017/unified_dashboard
# Local dev outside Docker: mongodb://127.0.0.1:27017/unified_dashboard
MONGODB_URL=mongodb://127.0.0.1:27017/unified_dashboard
# Comma-separated allowed frontend origins
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Redis cache and sync worker. Docker Compose hostname is `redis`.
REDIS_URL=redis://redis:6379
# Keep false when the worker container is running; true only if the API should run jobs itself.
SYNC_WORKER_INLINE=false
SYNC_CONCURRENCY=1
# Background loading of new shop data.
INBOX_AUTO_SYNC=true
INBOX_SYNC_MINUTES=5
ORDER_AUTO_SYNC=true
ORDER_SYNC_MINUTES=10
LISTING_AUTO_SYNC=true
LISTING_SYNC_MINUTES=15
ACCESS_AUTO_CHECK=true

# eBay
EBAY_CLIENT_ID=your_ebay_app_client_id
EBAY_CLIENT_SECRET=your_ebay_cert_client_secret
EBAY_DEV_ID=your_ebay_dev_id
EBAY_RUNAME=your_registered_ebay_runame
EBAY_ENV=PRODUCTION
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=

# TikTok Shop US
TIKTOK_SHOP_APP_KEY=your_tiktok_shop_app_key
TIKTOK_SHOP_APP_SECRET=your_tiktok_shop_app_secret
TIKTOK_SHOP_SERVICE_ID=your_tiktok_shop_service_id

# Temu US
TEMU_APP_KEY=your_temu_app_key
TEMU_APP_SECRET=your_temu_app_secret

# OpenAI (optional; Settings > AI agent overrides this)
OPENAI_API=

# Frontend. Leave VITE_API_URL empty in local dev so Vite proxies /api to port 5000.
VITE_API_URL=
VITE_PORT=5173
