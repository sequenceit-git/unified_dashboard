# NOTE: env now lives in ONE root file: unified_dashboard/.env (see ../.env.example).
# This file is kept only as a deploy fallback — prefer the root file for local dev.
PORT=5000
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/unified_dashboard?appName=<app>
# Comma-separated allowed frontend origins (local + deployed, no code changes needed).
CLIENT_URL=http://localhost:5173,https://unified-dashboard-lime.vercel.app
JWT_SECRET=<64-byte-hex-string>
JWT_EXPIRES_IN=7d
