# ==========================================
# Server & Database Settings
# ==========================================
PORT=5000
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/unified_dashboard?appName=<app>
# Comma-separated allowed frontend origins (local + deployed)
CLIENT_URL=http://localhost:5173,https://unified-dashboard-lime.vercel.app
JWT_SECRET=<64-byte-hex-string>
JWT_EXPIRES_IN=7d

# ==========================================
# 1. eBay REST API & OAuth Settings
# Developer portal: https://developer.ebay.com/
# ==========================================
# Your eBay App ID (Client ID)
EBAY_CLIENT_ID=your_ebay_app_client_id
# Your eBay Cert ID (Client Secret)
EBAY_CLIENT_SECRET=your_ebay_cert_client_secret
# Your eBay Developer ID
EBAY_DEV_ID=your_ebay_dev_id
# eBay RuName (eBay Redirect URL Name registered in eBay Dev Portal)
EBAY_RUNAME=your_registered_ebay_runame
# Environment: PRODUCTION or SANDBOX
EBAY_ENV=PRODUCTION

# ==========================================
# 2. TikTok Shop Open Platform Settings
# Developer portal: https://partner.tiktokshop.com/
# (US: partner.us.tiktokshop.com)
# ==========================================
# App Key / Service ID
TIKTOK_SHOP_APP_KEY=your_tiktok_shop_app_key
# App Secret
TIKTOK_SHOP_APP_SECRET=your_tiktok_shop_app_secret
# Registered Redirect URI for OAuth callback
TIKTOK_SHOP_REDIRECT_URI=http://localhost:5173/oauth/tiktok/callback
# Region: US, UK, SEA, or GLOBAL
TIKTOK_SHOP_REGION=US

# ==========================================
# 3. Temu Open Platform Settings
# Developer portal: https://seller.temu.com/ (Partner Platform / Client Management)
# ==========================================
# Temu App Key (Client ID)
TEMU_APP_KEY=your_temu_app_key
# Temu App Secret (Secret Key)
TEMU_APP_SECRET=your_temu_app_secret
# Callback URI if using redirect authorization
TEMU_REDIRECT_URI=http://localhost:5173/oauth/temu/callback
# Region: US, EU, or GLOBAL
TEMU_REGION=US
