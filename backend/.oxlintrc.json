{
  "$schema": "../frontend/node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error",
    "no-unreachable": "error",
    "no-unused-vars": [
      "warn",
      {
        "ignoreRestSiblings": true,
        "caughtErrors": "none",
        "argsIgnorePattern": "^_"
      }
    ],
    "unicorn/no-invalid-fetch-options": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "uploads"
  ]
}
