        "color": "red"
      },
      "FREEZE": {
        "label": "Frozen",
        "color": "red"
      },
      "DELETED": {
        "label": "Deleted",
        "color": "gray"
      }
    },
    "productForm": {
      "titleMax": 255,
      "maxImages": 9,
      "condition": false,
      "variants": true,
      "specifics": {
        "label": "Product attributes",
        "hint": "TikTok asks for attributes per category, matched when you list."
      },
      "packageDetails": {
        "required": true,
        "note": "TikTok needs package weight and size to make shipping labels."
      },
      "productStatus": {
        "draft": "Draft",
        "active": "Ready to publish",
        "archived": "Archived"
      },
      "listAction": "Publish to TikTok Shop",
      "directIntro": "TikTok Shop format: title, variants, brand, category attributes, size chart, certifications, required package size, and draft or direct listing."
    }
  },
