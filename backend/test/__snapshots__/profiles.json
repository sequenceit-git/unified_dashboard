      },
      "out_of_stock": {
        "label": "Out of stock",
        "color": "yellow"
      },
      "pending": {
        "label": "Reviewing",
        "color": "blue"
      },
      "paused": {
        "label": "Deactivated",
        "color": "gray"
      },
      "ended": {
        "label": "Deleted",
        "color": "gray"
      },
      "error": {
        "label": "Failed",
        "color": "red"
      }
    },
    "rawStatuses": {
      "ACTIVATE": {
        "label": "Live",
        "color": "green"
      },
      "PENDING": {
        "label": "Reviewing",
        "color": "blue"
      },
      "DRAFT": {
        "label": "Draft",
        "color": "gray"
      },
      "FAILED": {
        "label": "Failed",
        "color": "red"
      },
      "SELLER_DEACTIVATED": {
        "label": "Deactivated",
        "color": "gray"
      },
      "PLATFORM_DEACTIVATED": {
