{
  "ebay": {
    "label": "eBay",
    "sections": [
      {
        "id": "analytics",
        "label": "Analytics",
        "path": "/ebay/analytics",
        "route": "analytics",
        "needs": "Sell Fulfillment API"
      },
      {
        "id": "messages",
        "label": "Inbox",
        "path": "/ebay/messages",
        "route": "inbox",
        "needs": "commerce.message scope"
      },
      {
        "id": "listings",
        "label": "Listings",
        "path": "/ebay/listings",
        "route": "products",
        "needs": "Trading API"
      },
      {
        "id": "inventory",
        "label": "Inventory",
        "path": "/ebay/inventory",
        "route": "inventory",
        "needs": "Trading API"
      },
      {
        "id": "orders",
        "label": "Orders",
        "path": "/ebay/orders",
        "route": "orders",
        "needs": "sell.fulfillment scope"
      },
      {
        "id": "returns-cases",
        "label": "Returns & cases",
        "path": "/ebay/returns-cases",
        "route": "orders",
        "needs": "Post-Order API"
      },
      {
        "id": "offers",
        "label": "Best offers",
        "path": "/ebay/offers",
        "route": "products",
        "needs": "Negotiation API"
      },
      {
        "id": "promotions",
        "label": "Promotions",
        "path": "/ebay/promotions",
        "route": "products",
        "needs": "sell.marketing scope"
      },
      {
        "id": "advertising",
        "label": "Promoted Listings",
        "path": "/ebay/advertising",
        "route": "products",
        "needs": "sell.marketing scope"
      },
      {
        "id": "payouts",
        "label": "Payouts",
        "path": "/ebay/payouts",
        "route": "analytics",
        "needs": "sell.finances scope"
      },
      {
        "id": "buyers",
        "label": "Buyers",
        "path": "/ebay/buyers",
        "route": "customers",
        "needs": "sell.fulfillment scope"
      }
    ],
    "statuses": {
      "live": {
        "label": "Active",
        "color": "green"
      },
      "out_of_stock": {
        "label": "Out of stock",
        "color": "yellow"
      },
      "pending": {
        "label": "Pending",
        "color": "blue"
      },
      "paused": {
        "label": "Unsold",
        "color": "gray"
      },
      "ended": {
        "label": "Ended",
        "color": "gray"
      },
      "error": {
        "label": "Not listed",
        "color": "red"
      }
    },
    "rawStatuses": {},
    "productForm": {
      "titleMax": 80,
      "subtitleMax": 55,
      "maxImages": 12,
      "condition": true,
      "conditionDescription": true,
      "variants": true,
      "bestOffer": true,
      "dispatchTime": true,
      "mpn": true,
      "specifics": {
        "label": "Item specifics",
        "hint": "eBay asks for different specifics per category. Brand is always sent."
      },
      "packageDetails": {
        "required": false,
        "note": "Used by eBay for calculated shipping."
      },
      "productStatus": {
        "draft": "Draft",
        "active": "Ready to list",
        "archived": "Archived"
      },
      "listAction": "List on eBay",
      "directIntro": "eBay listing format: 80-character title, optional subtitle, condition & details, variations, category specifics, identifiers, Best Offer, and handling time."
    }
  },
