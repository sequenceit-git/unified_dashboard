{
  "ebay": {
    "label": "eBay",
    "sections": [
      {
        "id": "analytics",
        "label": "Analytics",
        "path": "/analytics",
        "route": "analytics",
        "needs": "Sell Fulfillment API"
      },
      {
        "id": "inbox",
        "label": "Inbox",
        "path": "/inbox",
        "route": "inbox",
        "needs": "commerce.message scope"
      },
      {
        "id": "products",
        "label": "Listings",
        "path": "/products",
        "route": "products",
        "needs": "Trading API"
      },
      {
        "id": "inventory",
        "label": "Inventory",
        "path": "/inventory",
        "route": "inventory",
        "needs": "Trading API"
      },
      {
        "id": "orders",
        "label": "Orders",
        "path": "/orders",
        "route": "orders",
        "needs": "sell.fulfillment scope"
      },
      {
        "id": "returns",
        "label": "Returns & cases",
        "path": "/shop/returns",
        "route": "orders",
        "needs": "Post-Order API"
      },
      {
        "id": "offers",
        "label": "Best offers",
        "path": "/shop/offers",
        "route": "products",
        "needs": "Negotiation API"
      },
      {
        "id": "promotions",
        "label": "Promotions",
        "path": "/shop/promotions",
        "route": "products",
        "needs": "sell.marketing scope"
      },
      {
        "id": "finances",
        "label": "Payouts",
        "path": "/shop/finances",
        "route": "analytics",
        "needs": "sell.finances scope"
      },
      {
        "id": "customers",
        "label": "Buyers",
        "path": "/customers",
        "route": "customers",
        "needs": "sell.fulfillment scope"
      }
    ],
    "statuses": {
      "live": {
        "label": "Active",
        "color": "green"
      },
      "out_of_stock": {
        "label": "Out of stock",
        "color": "yellow"
      },
      "pending": {
        "label": "Pending",
        "color": "blue"
      },
      "paused": {
        "label": "Unsold",
        "color": "gray"
      },
      "ended": {
        "label": "Ended",
        "color": "gray"
      },
      "error": {
        "label": "Not listed",
        "color": "red"
      }
    },
    "rawStatuses": {},
    "productForm": {
      "titleMax": 80,
      "subtitleMax": 55,
      "maxImages": 12,
      "condition": true,
      "conditionDescription": true,
      "variants": true,
      "bestOffer": true,
      "dispatchTime": true,
      "mpn": true,
      "specifics": {
        "label": "Item specifics",
        "hint": "eBay asks for different specifics per category. Brand is always sent."
      },
      "packageDetails": {
        "required": false,
        "note": "Used by eBay for calculated shipping."
      },
      "productStatus": {
        "draft": "Draft",
        "active": "Ready to list",
        "archived": "Archived"
      },
      "listAction": "List on eBay",
      "directIntro": "eBay listing format: 80-character title, optional subtitle, condition & details, variations, category specifics, identifiers, Best Offer, and handling time."
    }
  },
