# NOTE: env now lives in ONE root file: unified_dashboard/.env (see ../.env.example).
# Vite reads VITE_* from there via envDir. This file is kept only for reference.
# Local dev: leave empty to use the Vite proxy (/api → http://localhost:5000).
# Deployed (Vercel): set to the backend URL, e.g. VITE_API_URL=https://unified-dashboard-zdfw.vercel.app
# NOTE: Vite bakes VITE_* vars in at build time — set it in Vercel env vars, then redeploy.
VITE_API_URL=
VITE_PORT=5173
